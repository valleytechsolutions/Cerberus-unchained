* text=auto eol=lf
*.bin binary
*.png binary
*.zip binary
*.woff2 binary
# Release checksums cover exact bytes, including line endings in notices/JSON.
web/public/firmware/** -text -whitespace
web/public/notices.txt -text -whitespace
web/public/downloads/** -text -whitespace
web/public/fonts/*-LICENSE.txt -text -whitespace
# Preserve the imported Sentinel archive and its original checksum contract.
reference/sentinel-1.0.0/** -text -whitespace
# SD resource manifest hashes cover exact shipped file bytes.
sdcard/CERBERUS/** -text -whitespace
